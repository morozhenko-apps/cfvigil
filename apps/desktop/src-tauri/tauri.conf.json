{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CFVigil",
  "version": "0.1.0",
  "identifier": "com.morozhenko.cfvigil",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "CFVigil",
        "width": 390,
        "height": 92,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "Settings",
        "width": 460,
        "height": 660,
        "resizable": false,
        "visible": false,
        "maximizable": false,
        "decorations": false,
        "minimizable": false
      },
      {
        "label": "history",
        "url": "history.html",
        "title": "Event History",
        "width": 650,
        "height": 480,
        "resizable": true,
        "visible": false
      },
      {
        "label": "about",
        "url": "about.html",
        "title": "About CFVigil",
        "width": 400,
        "height": 310,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "maximizable": false,
        "minimizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Cloudflare deployments and incident monitoring",
    "license": "Apache-2.0",
    "licenseFile": "../../../LICENSE",
    "copyright": "Copyright (c) 2026 Stanislav Moseyko (morozhenko)",
    "linux": {
      "deb": {
        "depends": [
          "libgtk-layer-shell0"
        ]
      }
    }
  }
}

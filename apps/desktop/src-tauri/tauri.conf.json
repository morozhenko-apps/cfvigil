{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CFVigil",
  "version": "0.1.0",
  "identifier": "com.morozhenko.cfvigil",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {"label":"main","url":"index.html","title":"CFVigil","width":390,"height":122,"resizable":false,"visible":false,"decorations":false,"alwaysOnTop":true,"skipTaskbar":true,"transparent":true},
      {"label":"settings","url":"settings.html","title":"Settings","width":460,"height":390,"resizable":false,"visible":false,"maximizable":false},
      {"label":"history","url":"history.html","title":"Event History","width":650,"height":480,"resizable":true,"visible":false},
      {"label":"about","url":"about.html","title":"About CFVigil","width":400,"height":260,"resizable":false,"visible":false,"maximizable":false}
    ],
    "security": {"csp":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"}
  },
  "bundle": {"active":true,"icon":["icons/icon.png"],"category":"DeveloperTool","shortDescription":"Cloudflare deployments and incident monitoring","license":"Apache-2.0","licenseFile":"../../../LICENSE"}
}
